NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (server-side only, used by /api/valuation) — https://console.anthropic.com
ANTHROPIC_API_KEY=
